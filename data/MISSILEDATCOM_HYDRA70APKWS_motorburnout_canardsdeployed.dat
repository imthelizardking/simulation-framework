 DERIV DEG                                                                       
 DAMP                                                                            
  $FLTCON                                                                        
   NMACH=7.0, MACH(1)=0.5, 0.8, 1.2, 1.8, 2.5, 3.0, 3.5,                         
   NALPHA=6.0, ALPHA(1)=0.0, 2.0, 5.0, 10.0, 15.0, 20.0,                         
