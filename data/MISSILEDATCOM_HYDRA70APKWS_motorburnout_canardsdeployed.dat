   XCG=0.88, ZCG=0.0,                                                            
  $END                                                                           
  $AXIBOD                                                                        
   TNOSE=1., LNOSE=0.41, DNOSE=0.07,                                             
   LCENTR=1.06, DCENTR=0.07,                                                     
   DEXIT=0.0,                                                                    
