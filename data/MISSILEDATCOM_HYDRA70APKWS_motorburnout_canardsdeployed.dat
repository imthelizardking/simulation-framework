   SECTYP=0., NPANEL=4.0,                                                        
   XLE=0.35,                                                                     
   SSPAN(1)=0.0, 0.025,                                                          
   CHORD(1)=0.04, 0.02,                                                          
   ZUPPER(1)=0.005, 0.005,                                                       
   LMAXU(1)=0.5, 0.5,                                                            
   STA=0.0, SWEEP=15.0,                                                          
   PHIF(1)=0.0, 90.0, 180.0, 270.0,                                              
  $END                                                                           
  $FINSET2                                                                       
   SECTYP=0., NPANEL=3.0,                                                        
   XLE=1.33,                                                                     
   SSPAN(1)=0.035, 0.11,                                                         
   CHORD(1)=0.15, 0.08,                                                          
   ZUPPER(1)=0.01, 0.01875,                                                      
   LMAXU(1)=0.5, 0.5,                                                            
   STA=0.0, SWEEP=25.0,                                                          
   PHIF(1)=0.0, 120.0, 240.0,                                                    
  $END                                                                           
  $DEFLCT                                                                        
   DELTA2=-1.72, DELTA2=-1.72, DELTA3=-1.72,                                     
  $END                                                                           
