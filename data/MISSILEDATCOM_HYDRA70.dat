 DERIV DEG                                                                       
 DAMP                                                                            
  $FLTCON                                                                        
   NMACH=7.0, MACH(1)=0.5, 0.8, 1.2, 1.8, 2.5, 3.0, 3.5,                         
   NALPHA=6.0, ALPHA(1)=0.0, 2.0, 5.0, 10.0, 15.0, 20.0,                         
   ALT(1)=7*1000.0,                                                              
  $END                                                                           
  $REFQ                                                                          
   SREF=0.003848, LREF=0.07, LATREF=0.07,                                        
   XCG=0.75, ZCG=0.0,                                                            
  $END                                                                           
  $AXIBOD                                                                        
   TNOSE=1., LNOSE=0.41, DNOSE=0.07,                                             
   LCENTR=1.06, DCENTR=0.07,                                                     
   DEXIT=0.0,                                                                    
  $END                                                                           
  $FINSET1                                                                       
   SECTYP=0., NPANEL=3.0,                                                        
   XLE=1.33,                                                                     
   SSPAN(1)=0.035, 0.11,                                                         
   CHORD(1)=0.15, 0.08,                                                          
   ZUPPER(1)=0.01, 0.01875,                                                      
   LMAXU(1)=0.5, 0.5,                                                            
   STA=0.0, SWEEP=25.0,                                                          
   PHIF(1)=0.0, 120.0, 240.0,                                                    
  $END                                                                           
  $DEFLCT                                                                        
   DELTA1=-1.72, DELTA2=-1.72, DELTA3=-1.72,                                     
  $END                                                                           
 NEXT CASE                                                                       
